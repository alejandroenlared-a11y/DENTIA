generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  MANAGER
  RECEPTION
  DOCTOR
  READ_ONLY
}

enum PatientStatus {
  NEW_LEAD
  ACTIVE
  INACTIVE
  OPEN_BUDGET
  URGENT
}

enum PatientSex {
  MALE
  FEMALE
  OTHER
}

enum PatientIntakeStatus {
  CAPTURED
  LINKED
  DUPLICATE_REVIEW
  DISCARDED
}

enum AppointmentStatus {
  REQUESTED
  PROPOSED
  CONFIRMED
  COMPLETED
  NO_SHOW
  CANCELLED
  URGENT
}

enum ConversationChannel {
  VOICE
  WHATSAPP
  SMS
  WEB
  EMAIL
}

enum ClinicLocation {
  MURCIA
  ELCHE
}

enum ProviderLocationScope {
  MURCIA
  ELCHE
  BOTH
}

enum ConversationStatus {
  ACTIVE
  AI_HANDLING
  HUMAN_REQUIRED
  COMPLETED
  ARCHIVED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  SYSTEM
}

enum TaskStatus {
  OVERDUE
  PENDING
  SCHEDULED
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ConsentKind {
  DATA_PROCESSING
  CALL_RECORDING
  MARKETING
  AI_DISCLOSURE
}

enum AgentSessionOutcome {
  RESOLVED
  APPOINTMENT_CREATED
  ESCALATED
  FAILED
}

enum InvoiceStatus {
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum InvoiceReceiverType {
  PATIENT
  COMPANY
  PROFESSIONAL
  INSURER
  PUBLIC_ADMINISTRATION
}

enum InvoiceDocumentType {
  COMPLETE
  SIMPLIFIED
  RECTIFYING
}

enum ElectronicInvoiceStatus {
  NOT_REQUIRED
  READY
  PENDING
  SENT
  ACCEPTED
  REJECTED
  PAID
  FAILED
}

enum SifMode {
  NOT_CONFIGURED
  NO_VERIFACTU
  VERIFACTU
}

enum ExpenseCategory {
  LABORATORIO
  SUMINISTROS
  NOMINAS
  ALQUILER
  MARKETING
  FORMACION
  MANTENIMIENTO
  OTROS
}

enum ExpenseStatus {
  PENDING
  PAID
}

model Tenant {
  id                        String   @id @default(cuid())
  name                      String
  slug                      String   @unique
  legalName                 String?
  taxId                     String?
  fiscalAddress             String?
  phone                     String?
  address                   String?
  pmsProvider               String   @default("standalone")
  assistantName             String   @default("Clara")
  assistantEnabled          Boolean  @default(true)
  retentionDays             Int      @default(90)
  invoiceSeries             String   @default("F")
  electronicInvoiceProvider String?
  sifMode                   SifMode  @default(NOT_CONFIGURED)
  apiKey                    String?  @unique
  plan                      String   @default("PRO")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  users          User[]
  patients       Patient[]
  providers      Provider[]
  operatories    Operatory[]
  treatments     Treatment[]
  appointments   Appointment[]
  calendarEvents CalendarEvent[]
  conversations  Conversation[]
  patientIntakes PatientIntake[]
  tasks          Task[]
  consents       Consent[]
  auditLogs      AuditLog[]
  agentSessions  AgentSession[]
  invoices       Invoice[]
  expenses       Expense[]
  settings       TenantSetting?
}

model TenantSetting {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  tone            String
  escalationRules String
  rgpdNotes       String
  // Conocimiento libre de la clinica (equipo, especialidades, enrutado,
  // programas, diferenciadores) inyectado en el prompt del agente IA.
  knowledgeNotes  String?
  voiceEnabled    Boolean  @default(true)
  whatsappEnabled Boolean  @default(true)
  smsEnabled      Boolean  @default(true)
  webEnabled      Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  email        String
  passwordHash String?
  role         UserRole @default(RECEPTION)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Patient {
  id                   String               @id @default(cuid())
  tenantId             String
  primaryLocation      ClinicLocation       @default(MURCIA)
  name                 String
  lastName             String?
  sex                  PatientSex?
  birthDate            DateTime?
  idDocument           String?
  phone                String
  email                String?
  addressStreet        String?
  addressPostalCode    String?
  addressCity          String?
  addressProvince      String?
  guardianName         String?
  guardianRelationship String?
  guardianIdDocument   String?
  fiscalName           String?
  taxId                String?
  fiscalAddress        String?
  referredByProvider   String?
  status               PatientStatus        @default(NEW_LEAD)
  source               String?
  preferredChannel     ConversationChannel?
  treatmentNeed        String?
  estimatedValue       Int                  @default(0)
  lastVisitAt          DateTime?
  notes                String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments  Appointment[]
  conversations Conversation[]
  tasks         Task[]
  consents      Consent[]
  agentSessions AgentSession[]
  invoices      Invoice[]
  intakes       PatientIntake[]

  @@unique([tenantId, phone])
  @@index([tenantId, primaryLocation])
  @@index([tenantId, status])
}

model Provider {
  id            String                @id @default(cuid())
  tenantId      String
  name          String
  specialty     String
  locationScope ProviderLocationScope @default(BOTH)
  active        Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments   Appointment[]
  calendarEvents CalendarEvent[]

  @@index([tenantId, locationScope])
}

model Operatory {
  id        String         @id @default(cuid())
  tenantId  String
  location  ClinicLocation @default(MURCIA)
  name      String
  kind      String
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments   Appointment[]
  calendarEvents CalendarEvent[]

  @@index([tenantId, location])
}

model Treatment {
  id                 String   @id @default(cuid())
  tenantId           String
  name               String
  durationMinutes    Int
  priceCents         Int?
  requiresAssessment Boolean  @default(false)
  defaultProvider    String?
  defaultOperatory   String?
  rules              String
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([tenantId, name])
  @@index([tenantId, active])
}

model Appointment {
  id              String               @id @default(cuid())
  tenantId        String
  location        ClinicLocation       @default(MURCIA)
  patientId       String
  treatmentId     String?
  providerId      String?
  operatoryId     String?
  title           String
  startsAt        DateTime
  durationMinutes Int                  @default(30)
  status          AppointmentStatus    @default(REQUESTED)
  channel         ConversationChannel?
  createdByAi     Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  treatment Treatment? @relation(fields: [treatmentId], references: [id], onDelete: SetNull)
  provider  Provider?  @relation(fields: [providerId], references: [id], onDelete: SetNull)
  operatory Operatory? @relation(fields: [operatoryId], references: [id], onDelete: SetNull)

  @@index([tenantId, startsAt])
  @@index([tenantId, location])
  @@index([tenantId, status])
}

enum CalendarEventType {
  MEETING
  BLOCK
  ABSENCE
  OTHER
}

model CalendarEvent {
  id              String            @id @default(cuid())
  tenantId        String
  location        ClinicLocation    @default(MURCIA)
  providerId      String?
  operatoryId     String?
  title           String
  type            CalendarEventType @default(MEETING)
  startsAt        DateTime
  durationMinutes Int               @default(30)
  notes           String?
  createdByUserId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider  Provider?  @relation(fields: [providerId], references: [id], onDelete: SetNull)
  operatory Operatory? @relation(fields: [operatoryId], references: [id], onDelete: SetNull)

  @@index([tenantId, startsAt])
  @@index([tenantId, location])
  @@index([providerId, startsAt])
}

model Conversation {
  id        String              @id @default(cuid())
  tenantId  String
  patientId String?
  channel   ConversationChannel
  status    ConversationStatus  @default(ACTIVE)
  intent    String?
  result    String?
  unread    Boolean             @default(false)
  startedAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient       Patient?       @relation(fields: [patientId], references: [id], onDelete: SetNull)
  messages      Message[]
  agentSessions AgentSession[]
  patientIntake PatientIntake?

  @@index([tenantId, status])
  @@index([tenantId, channel])
}

model PatientIntake {
  id                  String               @id @default(cuid())
  tenantId            String
  patientId           String?
  conversationId      String?              @unique
  accessCode          String               @unique
  status              PatientIntakeStatus  @default(CAPTURED)
  name                String?
  email               String?
  phone               String?
  location            String?
  treatmentNeed       String?
  channel             ConversationChannel?
  source              String               @default("chat")
  consent             Boolean              @default(false)
  duplicatePatientIds Json?
  stateSnapshot       Json?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient      Patient?      @relation(fields: [patientId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, phone])
  @@index([tenantId, email])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  direction      MessageDirection
  senderName     String
  body           String
  metadata       Json?
  createdAt      DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Task {
  id         String       @id @default(cuid())
  tenantId   String
  patientId  String?
  title      String
  type       String
  status     TaskStatus   @default(PENDING)
  priority   TaskPriority @default(MEDIUM)
  dueAt      DateTime?
  linkedType String?
  linkedId   String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, dueAt])
}

model Consent {
  id        String      @id @default(cuid())
  tenantId  String
  patientId String
  kind      ConsentKind
  granted   Boolean     @default(false)
  grantedAt DateTime?
  source    String?
  createdAt DateTime    @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([tenantId, patientId, kind])
  @@index([tenantId, kind])
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
}

model AgentSession {
  id             String              @id @default(cuid())
  tenantId       String
  patientId      String?
  conversationId String?
  intent         String
  outcome        AgentSessionOutcome
  escalated      Boolean             @default(false)
  costCents      Int                 @default(0)
  latencyMs      Int?
  createdAt      DateTime            @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient      Patient?      @relation(fields: [patientId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, outcome])
}

model Invoice {
  id                     String                  @id @default(cuid())
  tenantId               String
  patientId              String
  number                 String
  series                 String                  @default("F")
  sequence               Int?
  documentType           InvoiceDocumentType     @default(COMPLETE)
  receiverType           InvoiceReceiverType     @default(PATIENT)
  receiverName           String?
  receiverTaxId          String?
  receiverAddress        String?
  receiverEmail          String?
  issuerLegalName        String?
  issuerTaxId            String?
  issuerAddress          String?
  treatmentName          String
  amountCents            Int
  taxBaseCents           Int                     @default(0)
  taxCents               Int                     @default(0)
  taxRateBasisPoints     Int                     @default(0)
  taxExemptionReason     String?
  status                 InvoiceStatus           @default(SENT)
  electronicStatus       ElectronicInvoiceStatus @default(NOT_REQUIRED)
  electronicFormat       String                  @default("FacturaE")
  electronicProvider     String?
  electronicReference    String?
  electronicPayload      String?
  electronicSubmittedAt  DateTime?
  electronicAcceptedAt   DateTime?
  electronicRejectedAt   DateTime?
  electronicRejectReason String?
  sifMode                SifMode                 @default(NOT_CONFIGURED)
  fiscalHash             String?
  previousFiscalHash     String?
  qrPayload              String?
  immutableIssued        Boolean                 @default(false)
  notes                  String?
  issuedAt               DateTime                @default(now())
  dueAt                  DateTime
  paidAt                 DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, electronicStatus])
  @@index([tenantId, issuedAt])
}

model Expense {
  id          String          @id @default(cuid())
  tenantId    String
  supplier    String
  category    ExpenseCategory
  amountCents Int
  status      ExpenseStatus   @default(PENDING)
  incurredAt  DateTime        @default(now())
  dueAt       DateTime?
  paidAt      DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, incurredAt])
}
