{
  "name": "dentia-ai-saas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "deploy:db": "prisma migrate deploy",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "eval:clara": "tsx scripts/evaluate-clara.ts",
    "quality:clara": "npm run eval:clara && npm test -- --run tests/clara-evaluation.test.ts",
    "quality:release": "npm run eval:clara && npm run lint && npm run typecheck && npm test -- --run && npm run build",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset-demo-patients": "tsx scripts/reset-demo-patients.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "@sentry/nextjs": "^10.66.0",
    "lucide-react": "^1.23.0",
    "next": "^16.2.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.2.10",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "^8.5.19"
  }
}
