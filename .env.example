DATABASE_URL="postgresql://dentia:dentia@localhost:56321/dentia_ai?schema=public"
APP_BASE_URL="http://localhost:3000"
DEFAULT_TENANT_SLUG="clinica-sonrisa-madrid"
WEBHOOK_SHARED_SECRET="cambia-este-secreto-largo-en-produccion"
DENTIA_ADMIN_EMAILS="owner@example.com"

# Observability. Keep tokens in Vercel, never in git.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Optional distributed rate limiting for Vercel/serverless.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional LLM providers. If missing, the agent uses deterministic local fallback.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.1-flash-lite"
GEMINI_FALLBACK_MODEL="gemini-3.5-flash"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6-terra"

# Set to 1 in production-like environments to remove the demo@dentia.ai / demo user on seed.
DEMO_LOGIN_DISABLED="1"
